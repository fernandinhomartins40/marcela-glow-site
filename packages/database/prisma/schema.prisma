// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  STAFF
  DOCTOR
  RECEPTION
  ASSISTANT
  CONTENT_EDITOR
  FINANCE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum Gender {
  FEMALE
  MALE
  NON_BINARY
  /// Registrado como "prefere não informar"
  UNDISCLOSED
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  STABLE_UNION
}

enum BloodType {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum RecordType {
  NOTE
  EVOLUTION
  PROCEDURE
  PHOTO
  ANAMNESIS
  ASSESSMENT
}

/// Categoria do item de catálogo clínico reutilizável
enum CatalogKind {
  MEDICATION
  EXAM
  GUIDANCE
  RECORD_TEMPLATE
}

/// Nível de controle sanitário do medicamento.
/// CONTROLLED e ANTIMICROBIAL exigem assinatura qualificada ICP-Brasil
/// (Lei 14.063/2020, art. 4º).
enum MedicationControl {
  COMMON
  ANTIMICROBIAL
  CONTROLLED
}

enum DocumentKind {
  PRESCRIPTION
  EXAM_REQUEST
  GUIDANCE
  CERTIFICATE
}

/// Conformidade da assinatura conforme Lei 14.063/2020
enum SignatureLevel {
  /// Assinatura do servidor: garante integridade, não tem fé pública
  INTERNAL
  /// Avançada — aceita para medicamentos comuns
  ADVANCED
  /// Qualificada ICP-Brasil — exigida para controlados e antimicrobianos
  QUALIFIED
}

enum PrescriptionStatus {
  DRAFT
  SENT
  VIEWED
  SIGNED
  CANCELLED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum NotificationChannel {
  EMAIL
  PUSH
  IN_APP
}

enum MessageSender {
  STAFF
  PATIENT
}

enum Permission {
  DASHBOARD_READ
  PATIENT_READ
  PATIENT_WRITE
  RECORD_READ
  RECORD_WRITE
  APPOINTMENT_READ
  APPOINTMENT_WRITE
  LEAD_READ
  LEAD_WRITE
  PRESCRIPTION_READ
  PRESCRIPTION_WRITE
  PRESCRIPTION_SIGN
  CMS_READ
  CMS_WRITE
  NOTIFICATION_SEND
  SETTINGS_READ
  SETTINGS_WRITE
  USER_MANAGE
  AUDIT_READ
  FILE_MANAGE
}

enum AuthSubjectType {
  STAFF
  PATIENT
}

enum AuditAction {
  LOGIN
  LOGOUT
  READ
  CREATE
  UPDATE
  DELETE
  EXPORT
  SIGN
  SEND
  REVOKE
}

enum FileVisibility {
  STAFF_ONLY
  PATIENT_VISIBLE
}

// ─────────────────────────────────────────────────────────────────────────────
// Tenant  (one row per clinic / white-label customer)
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  email     String
  phone     String
  address   String
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  users               User[]
  procedures          Procedure[]
  appointments        Appointment[]
  testimonials        Testimonial[]
  subscribers         NewsletterSubscriber[]
  patients            Patient[]
  leads               Lead[]
  medicalRecords      MedicalRecord[]
  procedureSessions   ProcedureSession[]
  prescriptions       Prescription[]
  documentTemplates   DocumentTemplate[]
  attachments         Attachment[]
  cmsPages            CmsPage[]
  landingContent      LandingContent[]
  landingImages       LandingImage[]
  blogPosts           BlogPost[]
  notifications       Notification[]
  messages            Message[]
  clinicSettings      ClinicSetting[]
  authSessions        AuthSession[]
  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]
  staffInvites        StaffInvite[]
  pushSubscriptions   PushSubscription[]
  userPermissions     UserPermission[]
  businessHours       BusinessHour[]
  scheduleBlocks      ScheduleBlock[]
  catalogItems        CatalogItem[]
}

// ─────────────────────────────────────────────────────────────────────────────
// User  (clinic staff / admins)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String
  passwordHash String
  name         String
  role         UserRole  @default(STAFF)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  tenantId     String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant                Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  medicalRecords        MedicalRecord[]
  sessions              AuthSession[]
  auditLogs             AuditLog[]
  resetTokens           PasswordResetToken[]
  invitesSent           StaffInvite[]        @relation("InviteSender")
  permissions           UserPermission[]
  uploadedAttachments   Attachment[]
  signedPrescriptions   Prescription[]       @relation("PrescriptionSigner")
  documentTemplates     DocumentTemplate[]   @relation("TemplateAuthor")
  confirmedAppointments Appointment[]        @relation("AppointmentConfirmer")

  @@unique([email, tenantId])
}

model UserPermission {
  id         String     @id @default(cuid())
  userId     String
  tenantId   String
  permission Permission
  createdAt  DateTime   @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
}

// ─────────────────────────────────────────────────────────────────────────────
// Procedure  (treatments / services offered)
// ─────────────────────────────────────────────────────────────────────────────

model Procedure {
  id           String   @id @default(cuid())
  number       String
  title        String
  subtitle     String
  description  String
  imageUrl     String?
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  /// Duração do atendimento em minutos — base para o cálculo de horários livres
  durationMin  Int      @default(60)
  /// Intervalo de limpeza/preparo somado após o atendimento
  bufferMin    Int      @default(0)
  /// Se false, o procedimento não é oferecido no agendamento online
  isBookable   Boolean  @default(true)
  tenantId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  sessions     ProcedureSession[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Appointment  (booking requests from patients)
// ─────────────────────────────────────────────────────────────────────────────

model Appointment {
  id          String            @id @default(cuid())
  name        String
  email       String
  phone       String
  message     String?
  status      AppointmentStatus @default(PENDING)
  procedureId String?
  patientId   String?
  tenantId    String
  scheduledAt DateTime?
  /// Fim do atendimento — derivado da duração do procedimento na confirmação.
  /// Persistido para que a checagem de conflito não dependa da duração atual.
  endsAt      DateTime?
  source      String?
  priceCents  Int?

  // Rastreio da confirmação
  confirmedAt   DateTime?
  confirmedById String?
  cancelledAt   DateTime?
  cancelReason  String?
  /// Marca quando a equipe disparou o aviso por WhatsApp
  notifiedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  procedure   Procedure? @relation(fields: [procedureId], references: [id], onDelete: SetNull)
  patient     Patient?   @relation(fields: [patientId], references: [id], onDelete: SetNull)
  confirmedBy User?      @relation("AppointmentConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)

  // Tudo que foi registrado durante o atendimento
  records       MedicalRecord[]
  prescriptions Prescription[]
  sessions      ProcedureSession[]

  @@index([tenantId, scheduledAt])
  @@index([tenantId, status])
}

/// Expediente semanal da clínica. Um registro por faixa de atendimento;
/// dias sem registro são considerados fechados.
model BusinessHour {
  id        String   @id @default(cuid())
  tenantId  String
  /// 0 = domingo … 6 = sábado
  weekday   Int
  /// "09:00" — hora local da clínica
  startTime String
  /// "18:00"
  endTime   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, weekday])
}

/// Períodos indisponíveis: férias, feriados, almoço, compromissos pessoais.
model ScheduleBlock {
  id        String   @id @default(cuid())
  tenantId  String
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, startsAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Testimonial  (patient reviews displayed on the site)
// ─────────────────────────────────────────────────────────────────────────────

model Testimonial {
  id           String   @id @default(cuid())
  authorName   String
  text         String
  rating       Int      @default(5)
  isVisible    Boolean  @default(true)
  displayOrder Int      @default(0)
  tenantId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Seções editáveis da landing. O identificador espelha o componente que a
/// renderiza, para o preview do painel e a página nunca divergirem.
enum LandingSection {
  /// Paleta de cores do site — nao e uma faixa da pagina, mas mora aqui
  /// porque tem o mesmo ciclo de vida: e editada, guardada por tenant e
  /// restaurada ao padrao pela mesma rota que as demais.
  THEME
  HERO
  ABOUT
  PROCEDURES
  TECHNOLOGY
  TESTIMONIALS
  APPOINTMENT
  FOOTER
  SEO
}

/// Conteúdo de uma seção da landing.
///
/// `content` é Json porque cada seção tem uma forma própria (o Hero tem
/// slides, o Rodapé tem redes sociais e horários) e uma coluna por campo
/// exigiria migration a cada texto novo. O formato de cada seção é validado
/// por schema Zod na API — o Json é o meio de guardar, não a ausência de
/// contrato.
model LandingContent {
  id          String         @id @default(cuid())
  section     LandingSection
  content     Json
  /// Seção oculta continua guardada: desligar não é apagar.
  isVisible   Boolean        @default(true)
  /// Ordem de exibição na página; Header e Rodapé ignoram.
  position    Int            @default(0)
  tenantId    String
  updatedById String?
  updatedAt   DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([section, tenantId])
}

/// Imagem da landing, já recortada no formato que a seção usa.
///
/// Separada de `Attachment` de propósito: aquele é documento clínico de uma
/// paciente, privado e sob retenção da LGPD. Estas são públicas, servidas pelo
/// nginx em /files/, e podem ser trocadas por quem edita o site sem qualquer
/// acesso a prontuário.
model LandingImage {
  id         String   @id @default(cuid())
  /// Onde a imagem é usada: "hero.0", "about.portrait", "footer.logo"
  slot       String
  storageKey String
  width      Int
  height     Int
  sizeBytes  Int
  mimeType   String
  /// Texto alternativo — obrigatório para leitor de tela
  alt        String
  tenantId   String
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([slot, tenantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// NewsletterSubscriber  (email marketing opt-ins)
// ─────────────────────────────────────────────────────────────────────────────

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String
  tenantId  String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([email, tenantId])
}

model Patient {
  id           String    @id @default(cuid())
  name         String
  email        String
  phone        String?
  passwordHash String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  birthDate    DateTime?
  notes        String?

  // ── Identificação ──
  /// Só dígitos. Identifica a paciente em receita e atestado e separa homônimas.
  cpf           String?
  rg            String?
  /// Como a paciente quer ser chamada, quando difere do nome civil (Lei 14.320/2022)
  socialName    String?
  gender        Gender?
  maritalStatus MaritalStatus?
  occupation    String?
  nationality   String?

  // ── Endereço ──
  /// Só dígitos
  zipCode      String?
  street       String?
  streetNumber String?
  complement   String?
  district     String?
  city         String?
  /// Sigla de duas letras
  state        String?

  // ── Contato de emergência ──
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?

  // ── Dados clínicos de base ──
  /// Campos da paciente, não do atendimento: precisam estar à mão ao prescrever.
  allergies       String?
  medications     String?
  conditions      String?
  surgeries       String?
  bloodType       BloodType?
  isPregnant      Boolean    @default(false)
  isBreastfeeding Boolean    @default(false)
  skinType        String?

  // ── Administrativo ──
  insuranceName   String?
  insuranceNumber String?
  /// Como conheceu a clínica: Instagram, indicação, busca…
  referralSource  String?
  referredBy      String?
  /// Consentimentos: guardam o instante para valer como prova (LGPD, art. 8º)
  lgpdConsentAt   DateTime?
  imageConsentAt  DateTime?

  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments      Appointment[]
  records           MedicalRecord[]
  sessions          ProcedureSession[]
  prescriptions     Prescription[]
  notifications     Notification[]
  messages          Message[]
  authSessions      AuthSession[]
  auditLogs         AuditLog[]
  resetTokens       PasswordResetToken[]
  pushSubscriptions PushSubscription[]
  attachments       Attachment[]
  leads             Lead[]

  @@unique([email, tenantId])
  @@unique([cpf, tenantId])
  @@index([tenantId, name])
}

model Lead {
  id           String     @id @default(cuid())
  name         String
  email        String?
  phone        String?
  origin       String?
  status       LeadStatus @default(NEW)
  nextFollowUp DateTime?
  notes        String?

  /// Ficha criada a partir deste contato. Sem isto a origem se perdia na
  /// conversão: a mesma pessoa virava dois registros sem ligação, e não havia
  /// como saber de qual campanha uma paciente tinha vindo.
  patientId   String?
  convertedAt DateTime?

  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
}

model MedicalRecord {
  id          String     @id @default(cuid())
  title       String
  type        RecordType @default(NOTE)
  body        String
  patientId   String
  createdById String?
  tenantId    String

  /// Data do atendimento — pode diferir de createdAt quando registrado depois
  occurredAt    DateTime?
  /// Queixa principal, em uma linha
  complaint     String?
  /// Conduta e plano terapêutico
  plan          String?
  /// Alergias, medicações em uso, comorbidades — texto livre por atendimento
  history       String?
  /// Prontuário assinado não pode mais ser alterado
  lockedAt      DateTime?
  /// Consulta que originou o registro. Opcional: retorno por telefone e
  /// encaixe também geram prontuário, sem passar pela agenda.
  appointmentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  attachments Attachment[]

  @@index([patientId, occurredAt])
  @@index([appointmentId])
}

model ProcedureSession {
  id             String   @id @default(cuid())
  patientId      String
  procedureId    String?
  tenantId       String
  performedAt    DateTime @default(now())
  notes          String?
  beforePhotoUrl String?
  afterPhotoUrl  String?
  priceCents     Int?
  /// Consulta em que o procedimento foi realizado
  appointmentId  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  procedure   Procedure?   @relation(fields: [procedureId], references: [id], onDelete: SetNull)
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([appointmentId])
}

/// Documento clínico entregue à paciente: receita, pedido de exame ou
/// orientação. O nome permanece Prescription por compatibilidade.
model Prescription {
  id               String             @id @default(cuid())
  patientId        String
  tenantId         String
  kind             DocumentKind       @default(PRESCRIPTION)
  title            String
  /// Texto livre: orientações gerais ou corpo do documento sem itens
  instructions     String
  status           PrescriptionStatus @default(DRAFT)
  sentAt           DateTime?
  signedAt         DateTime?
  signedById       String?
  signatureHash    String?
  signaturePayload Json?
  verificationCode String?            @unique

  /// Nível efetivo da assinatura aplicada — ver enum SignatureLevel
  signatureLevel SignatureLevel @default(INTERNAL)
  /// Receita comum vale 30 dias; controlada, 30; antimicrobiano, 10.
  validUntil     DateTime?
  /// Registrado quando a paciente abre o documento no portal
  viewedAt       DateTime?
  /// Consulta em que o documento foi emitido
  appointmentId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient     Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  signedBy    User?              @relation("PrescriptionSigner", fields: [signedById], references: [id], onDelete: SetNull)
  appointment Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  items       PrescriptionItem[]

  @@index([tenantId, kind, status])
  @@index([patientId, createdAt])
}

/// Catálogo clínico reutilizável: medicamentos, exames, orientações e modelos
/// de texto. Um modelo só, com `kind` discriminando, porque os quatro
/// compartilham busca, favoritos e ciclo de vida.
model CatalogItem {
  id         String      @id @default(cuid())
  kind       CatalogKind
  name       String
  /// Princípio ativo (medicamento) ou sinônimo de busca (exame)
  subtitle   String?
  /// Corpo do texto para GUIDANCE e RECORD_TEMPLATE
  body       String?
  isActive   Boolean     @default(true)
  /// Sobe os mais usados no topo da busca
  usageCount Int         @default(0)

  // ── Medicamento ──
  strength    String? /// "50mg/mL"
  form        String? /// "comprimido", "creme"
  route       String? /// "oral", "tópica"
  defaultDose String? /// "1 comprimido a cada 8 horas"
  defaultQty  String? /// "1 caixa"
  control     MedicationControl? @default(COMMON)

  // ── Exame ──
  tussCode    String?
  preparation String? /// "jejum de 8 horas"

  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prescriptionItems PrescriptionItem[]

  @@index([tenantId, kind, isActive])
}

/// Item de uma prescrição ou solicitação de exame. Estruturado (não texto
/// corrido) para que a farmácia leia posologia e quantidade sem ambiguidade.
model PrescriptionItem {
  id             String  @id @default(cuid())
  prescriptionId String
  /// Origem no catálogo; mantido mesmo se o item for editado à mão
  catalogItemId  String?

  /// Congelados na emissão: o catálogo pode mudar, o documento não.
  name         String
  strength     String?
  form         String?
  route        String?
  dose         String?
  quantity     String?
  notes        String?
  control      MedicationControl @default(COMMON)
  displayOrder Int               @default(0)

  createdAt DateTime @default(now())

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  catalogItem  CatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  @@index([prescriptionId])
}

model Attachment {
  id              String         @id @default(cuid())
  fileName        String
  url             String
  bucket          String?
  storageKey      String?
  mimeType        String?
  sizeBytes       Int?
  checksum        String?
  visibility      FileVisibility @default(STAFF_ONLY)
  medicalRecordId String?
  patientId       String?
  uploadedById    String?
  tenantId        String
  createdAt       DateTime       @default(now())

  medicalRecord MedicalRecord? @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  patient       Patient?       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  uploadedBy    User?          @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model CmsPage {
  id        String        @id @default(cuid())
  slug      String
  title     String
  body      String
  status    ContentStatus @default(DRAFT)
  tenantId  String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([slug, tenantId])
}

model BlogPost {
  id        String        @id @default(cuid())
  slug      String
  title     String
  excerpt   String?
  body      String
  coverUrl  String?
  status    ContentStatus @default(DRAFT)
  tenantId  String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([slug, tenantId])
}

model Notification {
  id        String              @id @default(cuid())
  title     String
  body      String
  channel   NotificationChannel @default(IN_APP)
  patientId String?
  tenantId  String
  readAt    DateTime?
  createdAt DateTime            @default(now())

  patient Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Message {
  id        String        @id @default(cuid())
  body      String
  sender    MessageSender
  patientId String
  tenantId  String
  createdAt DateTime      @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Modelo reutilizavel de documento: o conteudo que ja vem preenchido e o
/// layout com que ele e impresso. Um modelo pode trazer so o conteudo, so o
/// layout, ou os dois.
model DocumentTemplate {
  id           String       @id @default(cuid())
  name         String
  kind         DocumentKind @default(PRESCRIPTION)
  /// Titulo sugerido ao emitir a partir deste modelo
  title        String?
  /// Texto de orientacoes ja preenchido
  instructions String?
  /// Itens (medicamentos/exames) do modelo, no mesmo formato do documento
  items        Json?
  /// Layout de impressao: cabecalho, rodape, posicao da assinatura, margens.
  /// Nulo usa o layout padrao da clinica.
  layout       Json?
  /// Modelo padrao para este tipo: e o que a tela sugere primeiro
  isDefault    Boolean      @default(false)
  isActive     Boolean      @default(true)
  usageCount   Int          @default(0)
  tenantId     String
  createdById  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("TemplateAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, kind, isActive])
}

model ClinicSetting {
  id        String   @id @default(cuid())
  key       String
  value     Json
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([key, tenantId])
}

model AuthSession {
  id          String          @id @default(cuid())
  subjectType AuthSubjectType
  userId      String?
  patientId   String?
  tenantId    String
  tokenHash   String
  userAgent   String?
  ipAddress   String?
  revokedAt   DateTime?
  expiresAt   DateTime
  createdAt   DateTime        @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId, revokedAt])
  @@index([patientId, revokedAt])
}

model AuditLog {
  id          String           @id @default(cuid())
  tenantId    String
  action      AuditAction
  resource    String
  resourceId  String?
  subjectType AuthSubjectType?
  userId      String?
  patientId   String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime         @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  patient Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([resource, resourceId])
}

model PasswordResetToken {
  id          String          @id @default(cuid())
  subjectType AuthSubjectType
  userId      String?
  patientId   String?
  tenantId    String
  tokenHash   String          @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime        @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model StaffInvite {
  id          String       @id @default(cuid())
  email       String
  name        String?
  role        UserRole     @default(STAFF)
  permissions Permission[]
  tokenHash   String       @unique
  tenantId    String
  invitedById String?
  acceptedAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime     @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy User?  @relation("InviteSender", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([email, tenantId])
}

model PushSubscription {
  id          String          @id @default(cuid())
  endpoint    String          @unique
  keys        Json
  subjectType AuthSubjectType
  patientId   String?
  tenantId    String
  userAgent   String?
  revokedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  patient Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}
