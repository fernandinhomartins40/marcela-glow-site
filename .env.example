# Database
POSTGRES_USER=marcela
POSTGRES_PASSWORD=marcela_secure_pass_2024
POSTGRES_DB=marcela_glow
DATABASE_URL=postgresql://marcela:marcela_secure_pass_2024@localhost:5432/marcela_glow?schema=public

# API
JWT_SECRET=change-this-jwt-secret-in-production-must-be-32chars-min
BOOTSTRAP_TOKEN=change-this-bootstrap-token
PRESCRIPTION_SIGNING_SECRET=change-this-prescription-signing-secret
PRESCRIPTION_SIGNING_PRIVATE_KEY=
PRESCRIPTION_SIGNING_CERTIFICATE=
PUBLIC_APP_URL=http://localhost:3095
NODE_ENV=production
PORT=3001

# S3 compatible storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=marcela-files
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio-secret
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:3095/files

# E-mail transacional (recuperacao de senha, convite de equipe, agendamento).
# Sem SMTP_HOST/USER/PASSWORD o envio e desligado e o link vai para o log do
# servidor, entao o fluxo continua utilizavel em desenvolvimento.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Dra. Marcela Duch <nao-responda@drmarceladuch.com.br>

# Base publica usada nos links enviados por e-mail
PUBLIC_BASE_URL=http://localhost:3095

# Web Push / VAPID
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@drmarceladuch.com.br

# Frontend
VITE_API_URL=/api
VITE_TENANT_SLUG=marcela-duch
VITE_ADMIN_BASE=/admin/
VITE_PATIENT_BASE=/paciente/

# Nginx
EXTERNAL_PORT=3095

# CORS
CORS_ORIGIN=http://localhost:3095
